---
import { getCollection } from "astro:content";
import BlogArchive from "../../components/blog/BlogArchive.astro";
import { getBlogCategory } from "../../lib/blog-category";
import { isMainPost, isNoticePost, sortPostsByDate } from "../../lib/blog-publication";

export async function getStaticPaths({ paginate }) {
  const posts = sortPostsByDate(await getCollection("blog"));
  const mainPosts = posts.filter(isMainPost);
  const noticePosts = posts.filter(isNoticePost);

  const tagCounts = mainPosts.reduce<Record<string, number>>((counts, post) => {
    for (const tag of post.data.tags ?? []) {
      counts[tag] = (counts[tag] ?? 0) + 1;
    }
    return counts;
  }, {});

  const categoryCounts = mainPosts.reduce<Record<string, number>>((counts, post) => {
    const category = getBlogCategory(post);
    counts[category] = (counts[category] ?? 0) + 1;
    return counts;
  }, {});

  return paginate(mainPosts, {
    pageSize: Math.max(mainPosts.length, 1),
    props: {
      allPosts: mainPosts,
      noticePosts,
      tagCounts,
      categoryCounts,
    },
  });
}

const { page, allPosts = page.data, noticePosts = [], tagCounts = {}, categoryCounts = {} } = Astro.props;
---

<BlogArchive page={page} allPosts={allPosts} noticePosts={noticePosts} tagCounts={tagCounts} categoryCounts={categoryCounts} initialView="posts" />