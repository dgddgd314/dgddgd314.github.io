---
import { getCollection } from "astro:content";
import BlogArchive from "../../../../components/blog/BlogArchive.astro";
import { getBlogCategory } from "../../../../lib/blog-category";
import { isMainPost, isNoticePost, sortPostsByDate } from "../../../../lib/blog-publication";

export async function getStaticPaths({ paginate }) {
  const publishedPosts = sortPostsByDate(await getCollection("blog"));
  const posts = publishedPosts.filter(isMainPost);
  const noticePosts = publishedPosts.filter(isNoticePost);

  const tagCounts = posts.reduce<Record<string, number>>((counts, post) => {
    for (const tag of post.data.tags ?? []) {
      counts[tag] = (counts[tag] ?? 0) + 1;
    }
    return counts;
  }, {});

  const categoryCounts = posts.reduce<Record<string, number>>((counts, post) => {
    const category = getBlogCategory(post);
    counts[category] = (counts[category] ?? 0) + 1;
    return counts;
  }, {});

  const tags = Object.keys(tagCounts);

  return tags.flatMap((tag) => {
    const filteredPosts = posts.filter((post) => post.data.tags?.some((postTag) => postTag.toLowerCase() === tag.toLowerCase()));
    return paginate(filteredPosts, {
      params: { tag },
      pageSize: Math.max(filteredPosts.length, 1),
      props: {
        allPosts: posts,
        noticePosts,
        tagCounts,
        categoryCounts,
        initialTag: tag,
      },
    });
  });
}

const { page, allPosts = page.data, noticePosts = [], tagCounts = {}, categoryCounts = {}, initialTag = Astro.params.tag ?? "" } = Astro.props;
---

<BlogArchive page={page} allPosts={allPosts} noticePosts={noticePosts} tagCounts={tagCounts} categoryCounts={categoryCounts} initialView="tags" initialTag={initialTag} />