---
import { getCollection } from "astro:content";
import BlogArchive from "../../components/blog/BlogArchive.astro";
import { getBlogCategory } from "../../lib/blog-category";
import { isMainPost, isNoticePost, sortPostsByDate } from "../../lib/blog-publication";

const posts = sortPostsByDate(await getCollection("blog"));
const allPosts = posts.filter(isMainPost);
const noticePosts = posts.filter(isNoticePost);

const tagCounts = allPosts.reduce<Record<string, number>>((counts, post) => {
  for (const tag of post.data.tags ?? []) {
    counts[tag] = (counts[tag] ?? 0) + 1;
  }
  return counts;
}, {});

const categoryCounts = allPosts.reduce<Record<string, number>>((counts, post) => {
  const category = getBlogCategory(post);
  counts[category] = (counts[category] ?? 0) + 1;
  return counts;
}, {});

const page = { data: allPosts, url: {} };
---

<BlogArchive page={page} allPosts={allPosts} noticePosts={noticePosts} tagCounts={tagCounts} categoryCounts={categoryCounts} initialView="tags" />