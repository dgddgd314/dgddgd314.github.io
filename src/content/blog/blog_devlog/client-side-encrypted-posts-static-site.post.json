    {
      "id": "attack-cost-equation",
      "type": "equation",
      "equation": "\\operatorname{Cost}_{\\mathrm{attack}} \\approx N_{\\mathrm{candidates}} \\times c \\times \\operatorname{Cost}_{\\mathrm{HMAC}}"
    },
    {
      "id": "kdf-callout",
