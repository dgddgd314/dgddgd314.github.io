---
import BaseHead from "../components/BaseHead.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogType,
  mainClass = "p-6 pt-10 lg:max-w-[900px] max-w-[100vw]",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("dgddgd314.theme");
        const theme = stored === "dark" || stored === "light"
          ? stored
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <main class={mainClass}>
      <slot />
    </main>
    <ThemeToggle />
    <script is:inline>
      (() => {
        const key = "dgddgd314.theme";

        function storedTheme() {
          const stored = localStorage.getItem(key);
          if (stored === "dark" || stored === "light") return stored;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        function applyTheme() {
          document.documentElement.dataset.theme = storedTheme();
        }

        function updateToggle() {
          const dark = document.documentElement.dataset.theme === "dark";
          document.querySelectorAll("[data-theme-toggle-button]").forEach((button) => {
            button.setAttribute("aria-checked", String(dark));
          });
          document.querySelectorAll("[data-theme-label]").forEach((label) => {
            label.toggleAttribute("data-active", label.getAttribute("data-theme-label") === (dark ? "dark" : "light"));
          });
        }

        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element
            ? event.target.closest("[data-theme-toggle-button]")
            : null;
          if (!target) return;
          const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
          localStorage.setItem(key, theme);
          updateToggle();
        });

        applyTheme();
        updateToggle();
      })();
    </script>
  </body>
</html>
