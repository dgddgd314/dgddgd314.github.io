---
import { type BlogSchema } from "../content.config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";
import type { Block } from "../lib/blocks";
import { toEmbeddableImageUrl } from "../lib/image-url";
import type { TocItem } from "../lib/toc";
import type { EncryptedBlocks } from "../lib/encrypted-blocks";
import "../styles/blocks.css";

export interface Props extends BlogSchema {
  blocks?: Block[];
  tocItems?: TocItem[];
  encryptedBlocks?: EncryptedBlocks;
}

const { title, description, pubDate, updatedDate, status = [], tags = [], page, blocks = [], tocItems = [], encryptedBlocks } = Astro.props;
const isEncrypted = status.includes("encrypted") && Boolean(encryptedBlocks);
const pageIcon = page?.icon;
const pageCover = page?.cover;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
const numberedListStart = (items: Block[], index: number) => {
  if (items[index]?.type !== "numbered_list") return 1;
  let start = 1;
  for (let cursor = index - 1; cursor >= 0 && items[cursor]?.type === "numbered_list"; cursor -= 1) start += 1;
  return start;
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  includeSidebar={false}
  showHeader={false}
  showFooter={false}
  mainClass="notion-main"
>
  <div class="block-page">
    <article class="block-article" data-block-article>
      <header class:list={["block-hero", pageCover && "block-hero--has-cover", pageCover && `block-hero--${pageCover.type}`, pageIcon && "block-hero--has-icon"]}>
        <nav class="notion-breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a>
          <span>/</span>
          <span>{title}</span>
        </nav>
        {pageCover && (
          <div
            class:list={["block-cover", `block-cover--${pageCover.type}`]}
            style={pageCover.type === "color" ? `--block-cover-color: ${pageCover.value}` : undefined}
            aria-hidden="true"
          >
            {pageCover.type === "image" && (
              <img
                src={toEmbeddableImageUrl(pageCover.value)}
                alt=""
                style={`object-position: center ${pageCover.position ?? 50}%`}
                loading="eager"
                decoding="async"
              />
            )}
          </div>
        )}
        <div class="block-hero__content">
          {pageIcon && <div class="block-page-icon" aria-hidden="true">{pageIcon}</div>}
          <h1>{title}</h1>
          <p>{description}</p>
          <dl class="block-properties">
            {pubDate && (
              <div>
                <dt>Date</dt>
                <dd><time datetime={pubDate.toISOString()}>{displayDate}</time></dd>
              </div>
            )}
            {updatedDate && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={updatedDate.toISOString()}>{dayjs(updatedDate).format("ll")}</time></dd>
              </div>
            )}
            {status.length > 0 && (
              <div>
                <dt>Status</dt>
                <dd class="block-property-status">
                  {status.map((item) => <span class="block-badge">{item}</span>)}
                </dd>
              </div>
            )}
            {tags.length > 0 && (
              <div>
                <dt>Tags</dt>
                <dd class="block-property-tags">
                  {tags.map((tag) => (
                    <a href={`/blog/tag/${tag}`} class="block-tag" data-astro-reload>
                      {tag}
                    </a>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </div>
      </header>

      <div class="block-workspace">
        <div class="block-content-column">
          <div class="block-shell">
            <div class="block-document" data-encrypted-document={isEncrypted ? "true" : undefined}>
              {isEncrypted ? (
                <>
                  <form class="encrypted-document-lock" data-encrypted-form>
                    <span class="encrypted-document-lock__icon" aria-hidden="true">🔐</span>
                    <div class="encrypted-document-lock__copy">
                      <h2>암호화된 본문</h2>
                      <p>이 글의 본문을 보려면 공유받은 키를 입력하세요. 키는 브라우저 밖으로 전송되지 않습니다.</p>
                    </div>
                    <label class="encrypted-document-lock__field">
                      <span>암호 키</span>
                      <input type="password" data-encrypted-key autocomplete="current-password" required />
                    </label>
                    <button type="submit" data-encrypted-submit>본문 열기</button>
                    <p class="encrypted-document-lock__error" data-encrypted-error role="alert" hidden></p>
                  </form>
                  <div data-encrypted-content></div>
                  <script
                    type="application/json"
                    data-encrypted-payload
                    is:inline
                    set:html={JSON.stringify(encryptedBlocks).replaceAll("<", "\\u003c")}
                  />
                </>
              ) : (
                blocks.length > 0
                  ? blocks.map((block, index) => <BlockRenderer block={block} tocItems={tocItems} numberedListStart={numberedListStart(blocks, index)} />)
                  : <slot />
              )}
            </div>
          </div>
        </div>

        {(tocItems.length > 0 || isEncrypted) && (
          <aside class="block-outline block-bento__card" aria-label="Outline" data-encrypted-outline={isEncrypted ? "true" : undefined} hidden={isEncrypted}>
            <span class="block-bento__index">Outline</span>
            <nav>
              {tocItems.map((item) => (
                <a href={`#${item.id}`} class={`block-toc__link block-toc__link--${item.level}`} data-toc-link={item.id}>
                  {item.text}
                </a>
              ))}
            </nav>
          </aside>
        )}
      </div>
    </article>
  </div>

  <script>
    if (document.querySelector("[data-encrypted-document]")) {
      void import("../scripts/encrypted-post").then(({ initEncryptedPost }) => initEncryptedPost());
    }

    const headings = Array.from(document.querySelectorAll("[data-heading-block='true']"));
    const tocLinks = new Map(
      Array.from(document.querySelectorAll("[data-toc-link]")).map((link) => [
        link.getAttribute("data-toc-link"),
        link,
      ])
    );

    if ("IntersectionObserver" in window && headings.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

          if (!visible) return;

          tocLinks.forEach((link) => link.removeAttribute("aria-current"));
          tocLinks.get(visible.target.id)?.setAttribute("aria-current", "true");
        },
        { rootMargin: "-20% 0px -65% 0px", threshold: 0.01 }
      );

      headings.forEach((heading) => observer.observe(heading));
    }
  </script>
</BaseLayout>
