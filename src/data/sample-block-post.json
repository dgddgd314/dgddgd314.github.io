{
  "blocks": [
    {
      "id": "intro",
      "type": "heading",
      "level": 1,
      "richText": [{ "text": "Overview" }]
    },
    {
      "id": "intro-copy",
      "type": "paragraph",
      "richText": [
        { "text": "This page is a read-only block document. Every row is an independent block with a stable anchor, quiet hover state, and copy actions." }
      ]
    },
    {
      "id": "reader-note",
      "type": "callout",
      "icon": "i",
      "backgroundColor": "gray",
      "richText": [
        { "text": "The first pass is intentionally close to a clean Notion document. Bento section navigation sits above the article as the main adaptation layer." }
      ]
    },
    {
      "id": "model-heading",
      "type": "heading",
      "level": 1,
      "richText": [{ "text": "Block model" }]
    },
    {
      "id": "model-paragraph",
      "type": "paragraph",
      "richText": [
        { "text": "Rich text supports " },
        { "text": "bold", "annotations": { "bold": true } },
        { "text": ", " },
        { "text": "italic", "annotations": { "italic": true } },
        { "text": ", " },
        { "text": "underline", "annotations": { "underline": true } },
        { "text": ", " },
        { "text": "inline code", "annotations": { "code": true } },
        { "text": ", links, and inline annotations." }
      ]
    },
    {
      "id": "renderer-list-1",
      "type": "bulleted_list",
      "richText": [{ "text": "A central renderer selects the view by block type." }]
    },
    {
      "id": "renderer-list-2",
      "type": "bulleted_list",
      "richText": [{ "text": "Nested blocks render recursively without hydrating the full article." }]
    },
    {
      "id": "renderer-list-3",
      "type": "numbered_list",
      "richText": [{ "text": "Headings become stable anchors and generate navigation." }]
    },
    {
      "id": "todo-access",
      "type": "todo",
      "checked": true,
      "richText": [{ "text": "Keep toggles keyboard accessible with native details and summary elements." }]
    },
    {
      "id": "toggle-architecture",
      "type": "toggle",
      "richText": [{ "text": "Why keep rendering independent from the source?" }],
      "children": [
        {
          "id": "toggle-architecture-copy",
          "type": "paragraph",
          "richText": [{ "text": "The same block union can power local JSON today and a remote content source later. The article UI does not need to know where the blocks came from." }]
        },
        {
          "id": "toggle-architecture-code",
          "type": "code",
          "language": "ts",
          "code": "type BaseBlock = {\n  id: string;\n  type: string;\n  children?: Block[];\n};"
        }
      ]
    },
    {
      "id": "actions-heading",
      "type": "heading",
      "level": 1,
      "richText": [{ "text": "Navigation and actions" }]
    },
    {
      "id": "copy-heading",
      "type": "heading",
      "level": 2,
      "richText": [{ "text": "Copy actions" }]
    },
    {
      "id": "quote-actions",
      "type": "quote",
      "richText": [{ "text": "Blocks should feel quiet at rest and useful on hover: anchors, copy link, and copy text are visible without turning the page into an editor." }]
    },
    {
      "id": "table-heading",
      "type": "heading",
      "level": 1,
      "richText": [{ "text": "Responsive tables" }]
    },
    {
      "id": "capability-table",
      "type": "table",
      "hasHeaderRow": true,
      "rows": [
        [
          { "richText": [{ "text": "Capability" }] },
          { "richText": [{ "text": "Status" }], "align": "center" },
          { "richText": [{ "text": "Notes" }] }
        ],
        [
          { "richText": [{ "text": "Stable anchors" }] },
          { "richText": [{ "text": "Ready" }], "align": "center" },
          { "richText": [{ "text": "Every visible block exposes its ID." }] }
        ],
        [
          { "richText": [{ "text": "TOC tracking" }] },
          { "richText": [{ "text": "Ready" }], "align": "center" },
          { "richText": [{ "text": "Links work without JavaScript; active state improves the experience when JavaScript is available." }] }
        ],
        [
          { "richText": [{ "text": "Source adapter" }] },
          { "richText": [{ "text": "Later" }], "align": "center" },
          { "richText": [{ "text": "Local JSON is the first source." }] }
        ]
      ]
    },
    {
      "id": "reference-heading",
      "type": "heading",
      "level": 1,
      "richText": [{ "text": "References" }]
    },
    {
      "id": "bookmark-example",
      "type": "bookmark",
      "url": "https://docs.astro.build/",
      "title": "Astro documentation",
      "description": "A useful reference for extending this static block viewer."
    },
    {
      "id": "closing-divider",
      "type": "divider"
    },
    {
      "id": "closing",
      "type": "paragraph",
      "align": "center",
      "textColor": "gray",
      "richText": [{ "text": "The surface is now intentionally plain: document first, bento navigation second." }]
    }
  ]
}
